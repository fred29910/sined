{
  "name": "sined-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter editor dev",
    "build": "bun --filter '*' build",
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist apps/*/dist"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~7.0.2"
  }
}
